# Chave privada do deployer (NUNCA commite a chave real)
PRIVATE_KEY=0x...

# URL do RPC (Infura, Alchemy, etc.)
RPC_URL=https://sepolia.infura.io/v3/SEU_KEY

# Endereço do registry ERC-6551 (opcional — usa o canônico se não informado)
# REGISTRY_ADDRESS=0x000000006551c19487814612e58FE06813775758

# URI base para metadados dos NFTs
BASE_URI=https://api.herocard.io/metadata/

# Endereços pós-deploy (preencher após rodar o script)
HERO_CARD_ADDRESS=
ERC6551_ACCOUNT_IMPL=
ERC6551_REGISTRY=

# API keys para verificação de contratos
ETHERSCAN_API_KEY=
